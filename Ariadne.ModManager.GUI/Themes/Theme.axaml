<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="ContentFont">avares://Ariadne/Assets/Fonts/AtkinsonHyperlegible#Atkinson Hyperlegible</FontFamily>
    <FontFamily x:Key="MonoFont">avares://Ariadne/Assets/Fonts/AtkinsonHyperlegibleMono#Atkinson Hyperlegible Mono</FontFamily>
    <x:Double x:Key="UiFontSize">16</x:Double>
    <x:Double x:Key="UiFontSizeMedium">14</x:Double>
    <x:Double x:Key="UiFontSizeSmall">12</x:Double>

    <SolidColorBrush x:Key="AriadnePageBrush" Color="{DynamicResource BgMantle}" />
    <SolidColorBrush x:Key="AriadneSurfaceBrush" Color="{DynamicResource BgMantle}" />
    <SolidColorBrush x:Key="AriadneToolbarBackground" Color="{DynamicResource BgDarker}" />
    <SolidColorBrush x:Key="AriadneToolbarBorder" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="FgBaseBrush" Color="{DynamicResource FgBase}" />
    <SolidColorBrush x:Key="FgMutedBrush" Color="{DynamicResource FgMuted}" />
    <SolidColorBrush x:Key="FgDimmedBrush" Color="{DynamicResource FgDimmed}" />
    <SolidColorBrush x:Key="FgBrightBrush" Color="{DynamicResource FgBright}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentPrimary}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoft}" />
    <SolidColorBrush x:Key="AccentPrimaryFaintBrush" Color="{DynamicResource AccentPrimary}" Opacity="0.12" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource BgSelection}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource BgHover}" />
    <SolidColorBrush x:Key="ActiveListBrush" Color="{DynamicResource BgActiveList}" />
    <SolidColorBrush x:Key="BorderActiveBrush" Color="{DynamicResource BorderColor}" />

    <SolidColorBrush x:Key="GlassPanelBrush" Color="{DynamicResource GlassPanel}" />

    <SolidColorBrush x:Key="ConflictWinBrush" Color="#33A6E3A1" />
    <SolidColorBrush x:Key="ConflictLoseBrush" Color="#33F38BA8" />

    <!-- Menu / flyout tokens -->
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{DynamicResource GlassPanel}" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{DynamicResource GlassPanel}" />
    <SolidColorBrush x:Key="FlyoutPresenterBorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{DynamicResource BgHover}" />
    <SolidColorBrush x:Key="MenuFlyoutItemSelectedGlyphColor" Color="{DynamicResource AccentPrimary}" />

    <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}"
                  TargetType="MenuFlyoutPresenter"
                  BasedOn="{StaticResource {x:Type MenuFlyoutPresenter}}">
        <Setter Property="Background" Value="{DynamicResource GlassPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type Menu}"
                  TargetType="Menu"
                  BasedOn="{StaticResource {x:Type Menu}}">
        <Setter Property="Background" Value="{DynamicResource AriadneToolbarBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource FgBaseBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ContentFont}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type MenuItem}"
                  TargetType="MenuItem"
                  BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Foreground" Value="{DynamicResource FgBaseBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ContentFont}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource ActiveListBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource FgDimmedBrush}" />
        </Style>
    </ControlTheme>

    <!-- List metrics -->
    <x:Double x:Key="AriadneRowHeight">30</x:Double>
    <Thickness x:Key="AriadneCellPadding">0</Thickness>
    <x:Double x:Key="AriadneExpanderToggleWidth">26</x:Double>
    <x:Double x:Key="AriadneExpanderToggleHeight">26</x:Double>
    <x:Double x:Key="AriadneHierarchyIndent">16</x:Double>
    <Thickness x:Key="AriadneHierarchyContentMargin">6,0,0,0</Thickness>

    <!-- DataGrid selection visuals -->
    <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="{DynamicResource BgActiveList}" />
    <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="{DynamicResource BgActiveList}" />
    <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="{DynamicResource BgActiveList}" />
    <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="{DynamicResource BgActiveList}" />
    <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
    <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
    <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
    <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>

    <!-- DataGrid ControlThemes -->
    <ControlTheme x:Key="{x:Type DataGrid}"
                  TargetType="DataGrid"
                  BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="Background" Value="{DynamicResource AriadnePageBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource ContentFont}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource FgBaseBrush}" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type DataGridColumnHeader}"
                  TargetType="DataGridColumnHeader"
                  BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="{DynamicResource AriadneToolbarBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ContentFont}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="{DynamicResource AriadneCellPadding}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource AriadneToolbarBorderBrush}" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type DataGridRow}"
                  TargetType="DataGridRow"
                  BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource ActiveListBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource FgBrightBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type DataGridCell}"
                  TargetType="DataGridCell"
                  BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Padding" Value="{DynamicResource AriadneCellPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    </ControlTheme>

</ResourceDictionary>
