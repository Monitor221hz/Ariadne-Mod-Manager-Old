<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ariadne.ModManager.GUI.ViewModels"
             x:Class="Ariadne.ModManager.GUI.Views.GameSelectionView"
             x:DataType="vm:GameSelectionViewModel">

    <Border Background="{DynamicResource AriadneToolbarBackground}"
            BorderBrush="{DynamicResource AriadneToolbarBorder}"
            BorderThickness="1"
            BoxShadow="{DynamicResource GlassCardShadow}"
            CornerRadius="8"
            Padding="24"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <StackPanel Spacing="12">
            <TextBlock Text="Select a game"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock Text="Supported games detected on this machine. The chosen install path is bound to the instance."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource FgMutedBrush}" />
            <ListBox ItemsSource="{Binding DetectedGames}"
                     SelectedItem="{Binding SelectedGame}"
                     MinHeight="120"
                     MaxHeight="300">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetectedGameViewModel">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding InstallPath}"
                                       FontSize="11"
                                       Foreground="{DynamicResource FgDimmedBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="No supported game installs detected. Install a supported game (Steam) and restart."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AccentSoftBrush}"
                       IsVisible="{Binding NoGamesDetected}" />
            <Button Content="Continue"
                    Command="{Binding ContinueCommand}"
                    HorizontalAlignment="Right" />
        </StackPanel>
    </Border>
</UserControl>
