<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ariadne.ModManager.GUI.ViewModels"
             x:Class="Ariadne.ModManager.GUI.Views.InstanceSetupView"
             x:DataType="vm:InstanceSetupViewModel">

    <Border Background="{DynamicResource AriadneToolbarBackground}"
            BorderBrush="{DynamicResource AriadneToolbarBorder}"
            BorderThickness="1"
            BoxShadow="{DynamicResource GlassCardShadow}"
            CornerRadius="8"
            Padding="24"
            Width="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <StackPanel Spacing="12">
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Text="{Binding Game.Configuration.Name, StringFormat='New instance for: {0}'}" />
            <TextBlock Text="An instance holds the mods, profiles and staging for one game setup. Choose a name and a folder anywhere on disk."
                       TextWrapping="Wrap" />
            <TextBox PlaceholderText="Instance name"
                     Text="{Binding InstanceName}" />
            <TextBox PlaceholderText="Instance folder"
                     Text="{Binding InstanceFolder}" />
            <TextBlock Text="{Binding Error}"
                       Foreground="{DynamicResource AccentBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Button Content="Create instance"
                    Command="{Binding CreateCommand}"
                    HorizontalAlignment="Right" />
        </StackPanel>
    </Border>
</UserControl>
