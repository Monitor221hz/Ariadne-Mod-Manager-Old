<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ariadne.ModManager.GUI.ViewModels"
             xmlns:fi="using:FluentIcons.Avalonia"
             x:Class="Ariadne.ModManager.GUI.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">

    <Grid ColumnDefinitions="2*,Auto,512">
        <ContentControl Grid.Column="0" Content="{Binding ModList}" />
        <GridSplitter Grid.Column="1"
                      Width="4"
                      Background="{DynamicResource AriadneToolbarBorder}" />
        <TabControl Grid.Column="2" ItemsSource="{Binding SidePanelTabs}" SelectedItem="{Binding SelectedTab}" Padding="0">
            <TabControl.Styles>
                <Style Selector="TabItem" x:DataType="vm:IWorkspaceTab">
                    <Setter Property="Header" Value="{Binding Title}" />
                </Style>
            </TabControl.Styles>
        </TabControl>
    </Grid>
</UserControl>
