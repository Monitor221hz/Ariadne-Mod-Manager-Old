<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ariadne.ModManager.GUI.ViewModels"
             xmlns:hier="using:Avalonia.Controls.DataGridHierarchical"
             xmlns:views="using:Ariadne.ModManager.GUI.Views"
             xmlns:conv="using:Ariadne.ModManager.GUI.Converters"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:common="using:FluentIcons.Common"
             x:Class="Ariadne.ModManager.GUI.Views.DeployedView"
             x:DataType="vm:DeployedViewModel">

    <UserControl.Resources>
        <views:HierarchicalSortingAdapterFactory x:Key="HierarchicalSortingAdapterFactory" />
        <conv:FileIconConverter x:Key="FileIcon" />
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AriadneToolbarBackground}"
                BorderBrush="{DynamicResource AriadneToolbarBorder}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding SummaryTitle}" />
                <ComboBox MinWidth="160"
                          VerticalAlignment="Center"
                          IsVisible="{Binding TargetPickerVisible}"
                          ItemsSource="{Binding TargetRoots}"
                          SelectedItem="{Binding SelectedTarget}" />
            </StackPanel>
        </Border>
        <DataGrid x:Name="DeployedGrid"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HierarchicalModel="{Binding Model}"
                  HierarchicalRowsEnabled="True"
                  RowHeight="{DynamicResource AriadneRowHeight}"
                  SortingModel="{Binding SortingModel}"
                  SortingAdapterFactory="{StaticResource HierarchicalSortingAdapterFactory}"
                  CanUserSortColumns="True"
                  AutoGenerateColumns="False"
                  BorderThickness="0">
            <DataGrid.Columns>
                <DataGridHierarchicalColumn Header="Name"
                                            SortMemberPath="Item.Name"
                                            ColumnKey="name"
                                            Width="3*"
                                            x:DataType="hier:HierarchicalNode"
                                            Binding="{Binding Item}">
                    <DataGridHierarchicalColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DeployedRowViewModel">
                            <StackPanel Orientation="Horizontal">
                                <fi:FluentIcon Icon="{Binding Converter={StaticResource FileIcon}, FallbackValue={x:Static common:Icon.Document}}"
                                               IsVisible="{Binding ShowsIcon}"
                                               FontSize="20"
                                               Foreground="{DynamicResource FgDimmedBrush}"
                                               VerticalAlignment="Center" Padding="0" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridHierarchicalColumn.CellTemplate>
                </DataGridHierarchicalColumn>
                <DataGridTextColumn Header="Origin"
                                    SortMemberPath="Item.Origin"
                                    ColumnKey="origin"
                                    Width="*"
                                    x:DataType="hier:HierarchicalNode"
                                    Binding="{Binding ((vm:DeployedRowViewModel)Item).Origin}" />
                <DataGridTextColumn Header="Size"
                                    SortMemberPath="Item.SizeBytes"
                                    ColumnKey="size"
                                    Width="100"
                                    x:DataType="hier:HierarchicalNode"
                                    Binding="{Binding ((vm:DeployedRowViewModel)Item).SizeText}" />
                <DataGridTextColumn Header="Last Modified"
                                    SortMemberPath="Item.LastModifiedText"
                                    ColumnKey="lastModified"
                                    Width="140"
                                    x:DataType="hier:HierarchicalNode"
                                    Binding="{Binding ((vm:DeployedRowViewModel)Item).LastModifiedText}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
