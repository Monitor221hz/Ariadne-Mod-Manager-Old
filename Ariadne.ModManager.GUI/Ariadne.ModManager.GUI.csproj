<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Ariadne.ModManager.GUI</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Themes\Embedded\*.json" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>Ariadne</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="ByteSize" Version="2.1.2" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.339.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ReactiveList.Reactive" Version="5.3.0" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.0.3" />
    <PackageReference Include="ProDataGrid" Version="12.1.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ariadne.Downloads\Ariadne.Downloads.csproj" />
    <ProjectReference Include="..\Ariadne.WebProtocol\Ariadne.WebProtocol.csproj" />
    <ProjectReference Include="..\Ariadne.ModManager.Bethesda\Ariadne.ModManager.Bethesda.csproj" />
    <ProjectReference Include="..\Ariadne.ModManager\Ariadne.ModManager.csproj" />
    <ProjectReference Include="..\Ariadne.Security.Dpapi\Ariadne.Security.Dpapi.csproj" />
    <ProjectReference Include="..\Ariadne.Security.Libsecret\Ariadne.Security.Libsecret.csproj" />
    <ProjectReference Include="..\Ariadne.WebProtocol.Modl\Ariadne.WebProtocol.Modl.csproj" />
    <ProjectReference Include="..\Ariadne.WebProtocol.Nexus\Ariadne.WebProtocol.Nexus.csproj" />
  </ItemGroup>
</Project>
