<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Daedalus.ModManager.GUI.Views"
             xmlns:vm="using:Daedalus.ModManager.GUI.ViewModels"
             xmlns:converters="using:Daedalus.ModManager.GUI.Converters"
             xmlns:sys="using:System"
             x:Class="Daedalus.ModManager.GUI.App"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <views:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="ContentControlThemeFontFamily">avares://Mortex/Assets/Fonts/AtkinsonHyperlegible#Atkinson Hyperlegible, $Default</FontFamily>
            <sys:Double x:Key="ContentControlThemeFontSize">16</sys:Double>
            <converters:BandContrastForegroundConverter x:Key="BandContrastForeground" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Mortex/Themes/Theme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.v2.xaml" />
        <StyleInclude Source="avares://Mortex/Themes/ModListStyles.axaml" />
        <StyleInclude Source="avares://Mortex/Themes/ControlStyles.axaml" />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    </Application.Styles>
</Application>
