<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daedalus.ModManager.GUI.ViewModels"
             x:Class="Daedalus.ModManager.GUI.Views.FileLeafNodeView"
             x:DataType="vm:FileLeafNodeViewModel">

    <MaskedTextBox Text="{Binding DisplayName}"
              Classes="transparent"
              Foreground="{DynamicResource FgMutedBrush}"
              VerticalAlignment="Center"
              Margin="0,3"
              Background="Transparent" BorderThickness="0"
              IsReadOnly="True"
              Focusable="False"
              Cursor="Arrow"
              CaretBrush="Transparent"/>
</UserControl>
