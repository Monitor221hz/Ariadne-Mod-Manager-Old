<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daedalus.ModManager.GUI.ViewModels"
             xmlns:views="using:Daedalus.ModManager.GUI.Views"
             xmlns:fi="using:FluentIcons.Avalonia"
             x:Class="Daedalus.ModManager.GUI.Views.ModListView"
             x:DataType="vm:ModListViewModel">

    <UserControl.Resources>
        <views:HierarchicalSortingAdapterFactory x:Key="HierarchicalSortingAdapterFactory" />
    </UserControl.Resources>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:ModEntryNodeViewModel">
            <views:ModEntryNodeView />
        </DataTemplate>
        <DataTemplate DataType="vm:GroupHeaderNodeViewModel">
            <views:GroupHeaderNodeView />
        </DataTemplate>
        <DataTemplate DataType="vm:DirectoryNodeViewModel">
            <views:DirectoryNodeView />
        </DataTemplate>
        <DataTemplate DataType="vm:FileLeafNodeViewModel">
            <views:FileLeafNodeView />
        </DataTemplate>
        <DataTemplate DataType="vm:ArchiveLeafNodeViewModel">
            <views:ArchiveLeafNodeView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid>
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource DaedalusToolbarBackground}"
                BorderBrush="{DynamicResource DaedalusToolbarBorder}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button ToolTip.Tip="Create">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Create Empty Mod" Command="{Binding CreateModCommand}" />
                            <MenuItem Header="Create New Group" Command="{Binding CreateGroupCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <fi:SymbolIcon FontSize="16" Symbol="Add" />
                </Button>
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Profile:" />
                <ComboBox MinWidth="160"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding ProfileNames}"
                          SelectedItem="{Binding SelectedProfileName}" />
                <Button IsVisible="{Binding SortActive}"
                        Command="{Binding ClearSortCommand}"
                        ToolTip.Tip="Column sorting hides the drag &amp; drop order; clear to restore it">
                    <TextBlock Text="Clear Sort" />
                </Button>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource FgDimmedBrush}"
                           Text="{Binding CurrentGameText, TargetNullValue='', StringFormat='({0})'}" />
            </StackPanel>
        </Border>

        <DataGrid x:Name="ModsGrid" HierarchicalModel="{Binding Model}"
                  HierarchicalRowsEnabled="True"
                  RowHeight="{DynamicResource DaedalusRowHeight}"
                  SortingModel="{Binding SortingModel}"
                  SortingAdapterFactory="{StaticResource HierarchicalSortingAdapterFactory}"
                  CanUserSortColumns="True"
                  CanUserReorderRows="True"
                  RowDragHandle="RowHeaderAndRow"
                  RowDropHandler="{Binding DropHandler}"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  SelectionChanged="ModsGrid_SelectionChanged"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  ContextRequested="ModsGrid_ContextRequested">
            <DataGrid.Columns>
                <DataGridHierarchicalColumn Header="Name"
                                            SortMemberPath="Item.DisplayName"
                                            ColumnKey="name"
                                            Width="3*"
                                            x:CompileBindings="False"
                                            Binding="{Binding Item}">
                    <DataGridHierarchicalColumn.CellTemplate>
                        <DataTemplate x:CompileBindings="False">
                            <ContentControl Content="{Binding}" />
                        </DataTemplate>
                    </DataGridHierarchicalColumn.CellTemplate>
                </DataGridHierarchicalColumn>
                <DataGridTextColumn Header="Priority"
                                    SortMemberPath="Item.PriorityValue"
                                    ColumnKey="priority"
                                    Width="90"
                                    x:CompileBindings="False"
                                    Binding="{Binding Item.PriorityValue}" />
                <DataGridTextColumn Header="Version"
                                    SortMemberPath="Item.VersionText"
                                    ColumnKey="version"
                                    Width="120"
                                    x:CompileBindings="False"
                                    Binding="{Binding Item.VersionText}" />
                <DataGridTextColumn Header="Size"
                                    SortMemberPath="Item.SizeBytes"
                                    ColumnKey="size"
                                    Width="100"
                                    x:CompileBindings="False"
                                    Binding="{Binding Item.SizeText}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>

    <Border x:Name="RemoveOverlay"
            IsVisible="False"
            Background="#80000000">
        <Border Background="{DynamicResource DaedalusToolbarBackground}"
                BorderBrush="{DynamicResource DaedalusToolbarBorder}"
                BoxShadow="{DynamicResource GlassCardShadow}"
                BorderThickness="1"
                Padding="16"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="12" MinWidth="360">
                <TextBlock x:Name="RemovePromptText" FontWeight="SemiBold" />
                <TextBlock Text="The mod folder is deleted from disk. This cannot be undone."
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="DeleteModButton" Content="Delete" />
                    <Button x:Name="RemoveModCancelButton" Content="Cancel" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
    </Grid>
</UserControl>
