<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daedalus.ModManager.GUI.ViewModels"
             x:Class="Daedalus.ModManager.GUI.Views.GroupHeaderNodeView"
             x:DataType="vm:GroupHeaderNodeViewModel">

    <Border Padding="8,4"
            HorizontalAlignment="Stretch"
            Margin="0,3">
        <TextBlock Text="{Binding DisplayName}"
                   FontWeight="SemiBold"
                   Foreground="{Binding SeparatorBrush, Converter={StaticResource BandContrastForeground}}"
                   VerticalAlignment="Center" />
    </Border>
</UserControl>
