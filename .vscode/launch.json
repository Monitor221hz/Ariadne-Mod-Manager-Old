{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Ariadne GUI",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-gui",
            "program": "${workspaceFolder}/Ariadne.ModManager.GUI/bin/Debug/net10.0/Ariadne.exe",
            "args": [],
            "cwd": "${workspaceFolder}/Ariadne.ModManager.GUI/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Ariadne.VFS.WinFsp.Demo",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/Ariadne.VFS.WinFsp.Demo/bin/Debug/net10.0/Ariadne.VFS.WinFsp.Demo.exe",
            "args": [
                "${input:mode}",
                "${input:sourceDir}",
                "${input:mountPoint}",
                "${input:overwriteDir}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Ariadne.VFS.WinFsp.Demo (Release)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-release",
            "program": "${workspaceFolder}/Ariadne.VFS.WinFsp.Demo/bin/Release/net10.0/Ariadne.VFS.WinFsp.Demo.exe",
            "args": [
                "${input:mode}",
                "${input:sourceDir}",
                "${input:mountPoint}",
                "${input:overwriteDir}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        }
    ],
    "inputs": [
        {
            "id": "mode",
            "type": "pickString",
            "description": "Mount mode",
            "options": ["overlay", "overlay-nocow", "passthrough"],
            "default": "overlay"
        },
        {
            "id": "sourceDir",
            "type": "promptString",
            "description": "Source directory (content to expose)",
            "default": "E:/SteamLibrary/steamapps/common/Skyrim Special Edition"
        },
        {
            "id": "mountPoint",
            "type": "promptString",
            "description": "Mount point (must be empty or nonexistent)",
            "default": "E:/Empty"
        },
        {
            "id": "overwriteDir",
            "type": "promptString",
            "description": "Overwrite directory (runtime writes land here)",
            "default": "E:/Overwrite"
        }
    ]
}
