{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": ["build", "${workspaceFolder}/Daedalus.WinFsp.Demo/Daedalus.WinFsp.Demo.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-release",
            "command": "dotnet",
            "type": "process",
            "args": ["build", "${workspaceFolder}/Daedalus.WinFsp.Demo/Daedalus.WinFsp.Demo.csproj", "-c", "Release", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
            "problemMatcher": "$msCompile"
        }
    ]
}
