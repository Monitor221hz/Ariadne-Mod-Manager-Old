<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DaedalusModManagerCLI</AssemblyName>
    <RootNamespace>Daedalus.ModManager.CLI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Spectre.Console" Version="0.57.3-alpha.0.7" />
    <PackageReference Include="Spectre.Console.Analyzer" Version="1.0.1-preview.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.1-alpha.0.7" />
    <PackageReference Include="Spectre.Console.ImageSharp" Version="0.57.3-alpha.0.7" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Daedalus.Games\Daedalus.Games.csproj" />
    <ProjectReference Include="..\Daedalus.ModManager\Daedalus.ModManager.csproj" />
    <ProjectReference Include="..\Daedalus.VFS.Services\Daedalus.VFS.Services.csproj" />
  </ItemGroup>

</Project>
